{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Omenra",
  "description": "A lab for intelligence that acts: agents, models, tools, bots and robots built to see what comes next.",
  "colors": {
    "primary": "#1F8A5B",
    "light": "#5AC492",
    "dark": "#239363"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Vision",
        "href": "/vision"
      },
      {
        "href": "/company/roadmap",
        "label": "Roadmap"
      },
      {
        "href": "/faq",
        "label": "FAQ"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Build with us",
      "href": "/company/about"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["index", "vision", "quickstart", "glossary"]
      },
      {
        "group": "The five births",
        "pages": [
          "births/agents",
          "births/models",
          "births/tools",
          "births/bots",
          "births/robots"
        ]
      },
      {
        "group": "How it thinks",
        "pages": [
          "intelligence/prediction",
          "intelligence/memory",
          "intelligence/autonomy",
          "intelligence/orchestration"
        ]
      },
      {
        "group": "Building",
        "pages": ["build/lifecycle", "build/evaluation"]
      },
      {
        "group": "Control",
        "pages": ["control/safety", "control/governance"]
      },
      {
        "group": "Company",
        "pages": ["company/about", "company/roadmap"]
      },
      {
        "group": "Help",
        "pages": ["faq"]
      }
    ]
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111412"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Start here",
        "items": [
          {
            "label": "What is Omenra",
            "href": "/"
          },
          {
            "label": "Vision",
            "href": "/vision"
          },
          {
            "label": "Your first agent",
            "href": "/quickstart"
          },
          {
            "label": "Glossary",
            "href": "/glossary"
          }
        ]
      },
      {
        "header": "Platform",
        "items": [
          {
            "label": "The five births",
            "href": "/births/agents"
          },
          {
            "label": "How it thinks",
            "href": "/intelligence/prediction"
          },
          {
            "label": "Safety",
            "href": "/control/safety"
          }
        ]
      },
      {
        "header": "Company",
        "items": [
          {
            "label": "About",
            "href": "/company/about"
          },
          {
            "label": "Roadmap",
            "href": "/company/roadmap"
          },
          {
            "label": "FAQ",
            "href": "/faq"
          }
        ]
      }
    ]
  },
  "fonts": {
    "family": "Inter"
  },
  "banner": {
    "content": "🌱 Omenra is forming its first cohort of design partners. ✨ [Read more](/company/about#design-partners)",
    "dismissible": true,
    "color": {
      "light": "#1F8A5B",
      "dark": "#1A2A21"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ],
    "display": "header"
  }
}
